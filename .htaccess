RewriteEngine On
RewriteBase /otelex-server/api

# Block hidden files/directories such as .env, .git, and editor metadata.
RewriteRule (^|/)\. - [F,L]

# Never expose internal handlers, libraries, migrations, scheduler code, configuration, or database exports directly.
RewriteRule ^(?:includes|routes|utils|vendor|database|cron)(?:/|$) - [F,L,NC]
<FilesMatch "(^\.|\.(?:env|ini|log|sql|bak)$|^composer\.(?:json|lock)$)">
    Require all denied
</FilesMatch>

# All public API traffic must pass through the secured router.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

ErrorDocument 404 /otelex-server/api/index.php
