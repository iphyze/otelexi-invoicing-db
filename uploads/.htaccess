Options -Indexes

# Uploaded assets are static files only. Never execute server-side scripts here.
<FilesMatch "(?i)\.(php[0-9]*|phtml|pht|phar|cgi|pl|py|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
